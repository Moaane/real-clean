# Copy to .env and fill in. Never commit .env.
# Runtime connection. On Vercel/Neon use the POOLED url (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/goclean"
# Direct (non-pooled) url, used by prisma migrate. Optional locally.
DATABASE_URL_UNPOOLED=""
SESSION_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Midtrans (SANDBOX keys only)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# Signature Secret Key (Settings > Access Keys > Payment tab). Verifies webhook signature_key.
MIDTRANS_SIGNATURE_KEY=""

# SMTP (e.g. Mailtrap)
SMTP_HOST=""
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Real Clean <no-reply@realclean.test>"

# Seed passwords (local dev only)
SEED_PASSWORD="password123"

# Vercel Blob (work-proof photos)
BLOB_READ_WRITE_TOKEN=""
