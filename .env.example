# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/goclean"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Midtrans (SANDBOX keys only)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# SMTP (e.g. Mailtrap)
SMTP_HOST=""
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="GoClean <no-reply@goclean.test>"

# Seed passwords (local dev only)
SEED_PASSWORD="password123"
