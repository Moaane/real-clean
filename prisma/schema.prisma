generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  staff
  customer
}

enum PropertyType {
  house
  boarding_house
}

enum DetailLevel {
  regular
  detailed
  deep
}

enum BookingStatus {
  PENDING_PAYMENT
  EXPIRED
  PAID
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  AWAITING_VERIFICATION
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  pending
  settlement
  expire
  refund
}

enum RefundStatus {
  processing
  success
  failed
}

enum TaskStatus {
  assigned
  on_the_way
  in_progress
  awaiting_verification
  revision
  completed
  cancelled
}

model User {
  id_user    Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  role       Role
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  booking           Booking[]
  staff_assignments Assignment[] @relation("AssignmentStaff")
  admin_assignments Assignment[] @relation("AssignmentAdmin")
  refund            Refund[]

  @@map("users")
}

model Service {
  id_service                Int          @id @default(autoincrement())
  service_name              String       @db.VarChar(100)
  description               String?
  property_type             PropertyType
  detail_level              DetailLevel
  base_price                Int
  price_per_room            Int
  base_duration_minutes     Int
  duration_per_room_minutes Int
  min_rooms                 Int          @default(1)
  max_rooms                 Int
  is_active                 Boolean      @default(true)

  booking Booking[]

  @@unique([property_type, detail_level])
  @@map("service")
}

model OperatingHour {
  id         Int     @id @default(autoincrement())
  start_time String  @db.VarChar(5) // "HH:mm"
  end_time   String  @db.VarChar(5) // "HH:mm"
  quota      Int
  active     Boolean @default(true)

  @@unique([start_time, end_time])
  @@map("operating_hour")
}

model ScheduleSlot {
  id_slot    Int      @id @default(autoincrement())
  date       DateTime @db.Date
  start_time String   @db.VarChar(5) // "HH:mm"
  end_time   String   @db.VarChar(5) // "HH:mm"
  quota      Int
  filled     Int      @default(0)

  booking Booking[]

  @@unique([date, start_time])
  @@map("schedule_slot")
}

model Booking {
  id_booking          Int           @id @default(autoincrement())
  booking_code        String        @unique @db.VarChar(12)
  id_customer         Int
  id_service          Int
  id_slot             Int
  service_address     String
  room_count          Int
  // Snapshot taken when the booking is created: later price changes to a package do not affect old bookings.
  base_price          Int
  price_per_room      Int
  duration_minutes    Int
  total_price         Int
  status              BookingStatus @default(PENDING_PAYMENT)
  payment_deadline    DateTime
  notes               String?
  cancel_reason       String?
  cancel_requested_at DateTime?
  cancel_rejected     Boolean       @default(false)
  created_at          DateTime      @default(now())

  customer   User         @relation(fields: [id_customer], references: [id_user])
  service    Service      @relation(fields: [id_service], references: [id_service])
  slot       ScheduleSlot @relation(fields: [id_slot], references: [id_slot])
  payment    Payment?
  assignment Assignment[]

  @@index([id_customer])
  @@index([status])
  @@map("booking")
}

model Payment {
  id_payment      Int           @id @default(autoincrement())
  id_booking      Int           @unique
  order_id        String        @unique @db.VarChar(50)
  payment_method  String?       @db.VarChar(30)
  amount          Int
  payment_status  PaymentStatus @default(pending)
  payment_url     String?
  paid_at         DateTime?
  webhook_payload Json?
  created_at      DateTime      @default(now())

  booking Booking  @relation(fields: [id_booking], references: [id_booking])
  refund  Refund[]

  @@map("payment")
}

model Assignment {
  id_assignment  Int        @id @default(autoincrement())
  id_booking     Int
  id_staff       Int
  id_admin       Int
  task_status    TaskStatus @default(assigned)
  revision_notes String?
  assigned_at    DateTime   @default(now())
  started_at     DateTime?
  completed_at   DateTime?

  booking Booking     @relation(fields: [id_booking], references: [id_booking])
  staff   User        @relation("AssignmentStaff", fields: [id_staff], references: [id_user])
  admin   User        @relation("AssignmentAdmin", fields: [id_admin], references: [id_user])
  proof   WorkProof[]

  @@index([id_booking])
  @@index([id_staff])
  @@map("assignment")
}

model WorkProof {
  id_proof      Int      @id @default(autoincrement())
  id_assignment Int
  photo_url     String   @db.VarChar(255)
  remarks       String?
  uploaded_at   DateTime @default(now())

  assignment Assignment @relation(fields: [id_assignment], references: [id_assignment])

  @@index([id_assignment])
  @@map("work_proof")
}

model Refund {
  id_refund       Int          @id @default(autoincrement())
  id_payment      Int
  id_admin        Int
  amount          Int
  reason          String?
  refund_status   RefundStatus @default(processing)
  // Message from the gateway when the refund fails (shown to the admin).
  failure_message String?
  created_at      DateTime     @default(now())

  payment Payment @relation(fields: [id_payment], references: [id_payment])
  admin   User    @relation(fields: [id_admin], references: [id_user])

  @@map("refund")
}
